{
  "name": "keel-agent",
  "version": "0.2.0",
  "description": "Keel 龙骨 —— 可回放、可验证、可审计的编码智能体 CLI（event-sourced, evidence-driven coding agent）",
  "type": "module",
  "bin": {
    "keel": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "keywords": ["agent", "cli", "coding-agent", "event-sourcing", "harness"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
